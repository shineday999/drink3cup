---
// 預設語言(zh-Hant)不加網址前綴:/zh-Hant/... 一律 301 到 /...。
// 其他語言(en、ms-MY、id-ID)以 /<lang>/... 內部 rewrite 到對應頁面,語言由 middleware 依網址設定。
import { defaultLocale, isLocale } from "../../i18n/config";

const lang = Astro.params.lang ?? "";
const pathParts = Astro.params.path ?? [];
const joined = Array.isArray(pathParts) ? pathParts.join("/") : pathParts;
// 防止開放轉址:折疊開頭多餘的 / 與 \,確保只會轉到本站路徑
const subPath = ("/" + joined).replace(/^[/\\]+/, "/");

if (!isLocale(lang)) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
if (lang === defaultLocale) {
  return Astro.redirect(subPath + Astro.url.search, 301);
}

const KNOWN_TOP = new Set([
  "/",
  "/products",
  "/story",
  "/vision",
  "/roasting",
  "/origins",
  "/beans",
  "/brewing",
  "/blog",
  "/quiz",
  "/contact",
  "/about",
  "/more",
  "/cart",
  "/checkout",
  "/404",
]);
const known =
  KNOWN_TOP.has(subPath) ||
  subPath.startsWith("/blog/") ||
  subPath.startsWith("/products/") ||
  subPath.startsWith("/checkout/") ||
  subPath.startsWith("/quiz/");
if (!known) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
return Astro.rewrite(subPath);
---
