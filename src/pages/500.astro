---
import { env } from "cloudflare:workers";

// 500 — Server error (Wave 68)
// Reuse 404 Morning Mist illustration layout (zen + atmospheric)
// Wording shifts from "lost path" to "moment of disorder, take a breath, try again".
// Same Suggested products + search input pattern (Wave 67) so 500 also points forward.
import Layout from "@layouts/Layout.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import { createT } from "../i18n/t";
import { defaultLocale, localizedPath, type Locale } from "../i18n/config";

const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const homePath = localizedPath(locale, "/");
const productsPath = localizedPath(locale, "/products");
const t = createT(messages);
const title = t("500.title");
const subtitle = t("500.subtitle");
const ctaPrimary = t("500.cta_primary");
const ctaSecondary = t("500.cta_secondary");
const kicker = t("500.kicker");
const pageTitle = t("common.site_name") + " — " + title;

// Wave 68: 3 active products (latest) for "您或許想看" suggestions
interface SuggestedProduct {
  slug: string;
  name: string | null;
  short_description: string | null;
  category: string;
}
const suggested = env?.DB
  ? await env.DB.prepare(
      `SELECT p.slug, p.category, pt.name, pt.short_description
       FROM products p
       LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
       WHERE p.status = 'active'
       ORDER BY p.created_at DESC LIMIT 3`,
    )
      .bind(locale)
      .all<SuggestedProduct>()
  : { results: [] as SuggestedProduct[] };

const suggestedProducts = suggested.results ?? [];
---

<Layout title={pageTitle} description={subtitle}>
  <main
    class="min-h-[70vh] flex items-center justify-center px-6 py-16 md:py-24 overflow-hidden"
  >
    <div
      class="w-full max-w-6xl mx-auto grid grid-cols-12 gap-8 md:gap-12 items-center"
    >
      <!-- Left col: Atmospheric SVG illustration (Morning Mist, same as 404) -->
      <div class="col-span-12 md:col-span-7 order-1 md:order-1">
        <div class="relative w-full aspect-[4/5] max-h-[70vh] mx-auto">
          <svg
            viewBox="0 0 400 500"
            class="w-full h-full block"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="xMidYMid slice"
            role="img"
            aria-label={t("404.svg_aria")}
          >
            <defs>
              <linearGradient id="dawn-500" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#322216"></stop>
                <stop offset="40%" stop-color="#422f21"></stop>
                <stop offset="70%" stop-color="#725540"></stop>
                <stop offset="100%" stop-color="#FAF7EE"></stop>
              </linearGradient>

              <radialGradient id="mist-glow-500" cx="50%" cy="78%" r="55%">
                <stop offset="0%" stop-color="#FAF7EE" stop-opacity="0.55"
                ></stop>
                <stop offset="100%" stop-color="#FAF7EE" stop-opacity="0"
                ></stop>
              </radialGradient>

              <linearGradient id="amber-leaf-500" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#D4A574"></stop>
                <stop offset="100%" stop-color="#8C6B3E"></stop>
              </linearGradient>

              <filter
                id="mist-blur-500"
                x="-20%"
                y="-20%"
                width="140%"
                height="140%"
              >
                <feGaussianBlur stdDeviation="8"></feGaussianBlur>
              </filter>
            </defs>

            <rect width="400" height="500" fill="url(#dawn-500)"></rect>
            <rect width="400" height="500" fill="url(#mist-glow-500)"></rect>

            <g class="mist-1" filter="url(#mist-blur-500)">
              <ellipse
                cx="120"
                cy="380"
                rx="190"
                ry="24"
                fill="#FAF7EE"
                opacity="0.38"></ellipse>
            </g>

            <g class="mist-2" filter="url(#mist-blur-500)">
              <ellipse
                cx="290"
                cy="420"
                rx="230"
                ry="20"
                fill="#FAF7EE"
                opacity="0.28"></ellipse>
            </g>

            <g
              class="pine-branch"
              stroke="#322216"
              stroke-width="2.5"
              stroke-linecap="round"
              fill="none"
            >
              <path d="M 100 500 L 108 180"></path>
              <path d="M 106 360 L 56 320"></path>
              <path d="M 108 320 L 152 290"></path>
              <path d="M 107 270 L 64 230"></path>
              <path d="M 109 230 L 148 210"></path>
              <path d="M 107 410 L 78 388"></path>
              <circle cx="56" cy="320" r="3.5" fill="#422f21" stroke="none"
              ></circle>
              <circle cx="152" cy="290" r="3.5" fill="#422f21" stroke="none"
              ></circle>
              <circle cx="64" cy="230" r="3.5" fill="#422f21" stroke="none"
              ></circle>
              <circle cx="148" cy="210" r="3.5" fill="#422f21" stroke="none"
              ></circle>
              <circle cx="78" cy="388" r="3.5" fill="#422f21" stroke="none"
              ></circle>
              <circle cx="108" cy="180" r="4" fill="#422f21" stroke="none"
              ></circle>
            </g>

            <g class="leaf-fall">
              <path
                d="M 0 0 C -10 -5 -12 -14 -5 -18 C 7 -20 16 -11 14 -2 C 12 7 5 9 0 0 Z"
                fill="url(#amber-leaf-500)"
                transform="translate(0 0) rotate(-15)"></path>
            </g>
          </svg>
        </div>
      </div>

      <!-- Right col: Brand copy + dual CTA -->
      <RevealOnScroll class="col-span-12 md:col-span-5 order-2 md:order-2">
        <div>
          <p class="text-xs uppercase tracking-[0.4em] text-text-muted mb-8">
            {kicker}
          </p>
          <h1
            class="font-serif text-5xl md:text-6xl lg:text-7xl text-forest-800 leading-[1.05] mb-6"
          >
            {title}
          </h1>
          <p
            class="text-lg md:text-xl text-text-secondary mb-12 leading-relaxed"
          >
            {subtitle}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={homePath}
              class="inline-block px-8 py-3 bg-forest-800 text-bg-base font-sans text-sm tracking-wider hover:bg-forest-900 transition-colors duration-300"
              >{ctaPrimary}</a
            >
            <a
              href={productsPath}
              class="inline-block px-8 py-3 border border-forest-800 text-forest-800 font-sans text-sm tracking-wider hover:bg-forest-800 hover:text-bg-base transition-colors duration-300"
              >{ctaSecondary}</a
            >
          </div>
        </div>
      </RevealOnScroll>
    </div>

    <!-- Wave 68: Suggested products + search input (500 dead-end → paths forward) -->
    <section
      class="mt-16 md:mt-24 max-w-5xl mx-auto px-2"
      aria-labelledby="suggested-heading-500"
    >
      <h2
        id="suggested-heading-500"
        class="font-serif text-2xl md:text-3xl text-forest-800 mb-6 text-center"
      >
        {t("500.suggested_heading")}
      </h2>

      {
        suggestedProducts.length > 0 ? (
          <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mb-12">
            {suggestedProducts.map((p) => {
              const pPath = localizedPath(locale, `/products/${p.slug}`);
              return (
                <li>
                  <a
                    href={pPath}
                    class="block p-5 bg-bg-card border border-text-muted/20 rounded-card hover:border-forest-700 transition-colors duration-300"
                  >
                    <h3 class="font-serif text-lg text-forest-800 mb-2">
                      {p.name ?? p.slug}
                    </h3>
                    <p class="text-sm text-text-secondary line-clamp-2">
                      {p.short_description ?? ""}
                    </p>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : null
      }

      <form
        method="GET"
        action={productsPath}
        role="search"
        class="max-w-xl mx-auto"
      >
        <label for="product-search-500" class="sr-only">
          {t("500.search_label")}
        </label>
        <div class="flex gap-2">
          <input
            id="product-search-500"
            type="search"
            name="q"
            placeholder={t("500.search_placeholder")}
            class="flex-1 px-4 py-3 border border-text-muted/30 rounded-md bg-bg-base text-text-primary focus:outline-none focus:border-forest-700"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-forest-800 text-bg-base font-sans text-sm tracking-wider hover:bg-forest-900 transition-colors duration-300 rounded-md"
          >
            {t("500.search_label")}
          </button>
        </div>
      </form>
    </section>
  </main>
</Layout>

<style>
  .mist-1 {
    animation: mist-drift-a 38s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }
  .mist-2 {
    animation: mist-drift-b 22s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }
  .pine-branch {
    animation: branch-sway 12s ease-in-out infinite alternate;
    transform-origin: 50% 100%;
    will-change: transform;
  }
  .leaf-fall {
    animation: leaf-fall 18s ease-in-out infinite;
    transform-origin: center;
    will-change: transform, opacity;
  }

  @keyframes mist-drift-a {
    0% {
      transform: translateX(-22px);
      opacity: 0.32;
    }
    100% {
      transform: translateX(38px);
      opacity: 0.5;
    }
  }
  @keyframes mist-drift-b {
    0% {
      transform: translateX(32px);
      opacity: 0.22;
    }
    100% {
      transform: translateX(-32px);
      opacity: 0.4;
    }
  }
  @keyframes branch-sway {
    0% {
      transform: rotate(-0.6deg);
    }
    100% {
      transform: rotate(0.6deg);
    }
  }
  @keyframes leaf-fall {
    0% {
      transform: translate(220px, -50px) rotate(0deg);
      opacity: 0;
    }
    8% {
      opacity: 0.95;
    }
    25% {
      transform: translate(186px, 80px) rotate(60deg);
    }
    50% {
      transform: translate(146px, 200px) rotate(180deg);
    }
    75% {
      transform: translate(186px, 320px) rotate(280deg);
    }
    92% {
      opacity: 0.95;
    }
    100% {
      transform: translate(220px, 400px) rotate(360deg);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mist-1,
    .mist-2,
    .pine-branch,
    .leaf-fall {
      animation: none !important;
    }
    .leaf-fall {
      transform: translate(146px, 200px) rotate(180deg);
      opacity: 0.95;
    }
  }
</style>
