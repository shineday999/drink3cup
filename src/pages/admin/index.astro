---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { env } from "cloudflare:workers";
import { createT, tEnum } from "../../i18n/t";
import { defaultLocale, type Locale } from "../../i18n/config";
import zhHansMessages from "../../i18n/messages/zh-Hans.json";
import { formatPrice, getRates } from "../../lib/format";

// 概览：一屏看完「數字 → 待辦 → 最近訂單」。導覽入口都在側邊欄，這裡不再放重複的入口卡片。
const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);

interface RecentOrder {
  id: string;
  customer_name: string;
  total: number;
  currency: string;
  status: string;
  created_at: number;
}

let stats = {
  products: 0,
  orders: 0,
  pendingReviews: 0,
  totalRevenue: 0,
  pendingOrders: 0,
  draftProducts: 0,
};
let recent: RecentOrder[] = [];

if (env?.DB) {
  try {
    const count = async (sql: string): Promise<number> =>
      (await env.DB.prepare(sql).first<{ c: number }>())?.c ?? 0;

    const revenueRows = await env.DB.prepare(
      "SELECT currency, COALESCE(SUM(total), 0) AS s FROM orders WHERE payment_status = 'paid' GROUP BY currency",
    ).all<{ currency: string; s: number }>();
    // 舊訂單可能是美元，新訂單是人民幣：先各自換成人民幣再加總
    const rates = getRates();
    const revenueCny = (revenueRows.results ?? []).reduce(
      (sum, r) => sum + r.s / (rates[r.currency] ?? 1),
      0,
    );
    const latest = await env.DB.prepare(
      "SELECT id, customer_name, total, currency, status, created_at FROM orders ORDER BY created_at DESC LIMIT 5",
    ).all<RecentOrder>();

    stats = {
      products: await count("SELECT COUNT(*) AS c FROM products"),
      orders: await count("SELECT COUNT(*) AS c FROM orders"),
      pendingReviews: await count(
        "SELECT COUNT(*) AS c FROM reviews WHERE status = 'pending'",
      ),
      totalRevenue: Math.round(revenueCny),
      pendingOrders: await count(
        "SELECT COUNT(*) AS c FROM orders WHERE status = 'pending'",
      ),
      draftProducts: await count(
        "SELECT COUNT(*) AS c FROM products WHERE status = 'draft'",
      ),
    };
    recent = latest.results ?? [];
  } catch (e) {
    console.error("[admin dashboard] DB query failed", e);
  }
}

function statusColor(s: string) {
  return s === "pending"
    ? "bg-warning/20 text-warning"
    : s === "confirmed" || s === "shipped"
      ? "bg-forest-100 text-forest-700"
      : s === "delivered"
        ? "bg-success/20 text-success"
        : "bg-error/20 text-error";
}

const todos = [
  {
    label: "待处理订单",
    n: stats.pendingOrders,
    href: "/admin/orders?status=pending",
  },
  { label: "待审核评论", n: stats.pendingReviews, href: "/admin/reviews" },
  {
    label: "草稿商品（未上架）",
    n: stats.draftProducts,
    href: "/admin/products",
  },
];
const cards = [
  {
    label: t("admin.dashboard.stat_products"),
    value: String(stats.products),
    href: "/admin/products",
    tone: "text-forest-700",
  },
  {
    label: t("admin.dashboard.stat_orders"),
    value: String(stats.orders),
    href: "/admin/orders",
    tone: "text-forest-700",
  },
  {
    label: t("admin.dashboard.stat_pending_reviews"),
    value: String(stats.pendingReviews),
    href: "/admin/reviews",
    tone: "text-accent-700",
  },
  {
    label: t("admin.dashboard.stat_revenue"),
    value: formatPrice(stats.totalRevenue, "CNY", locale),
    href: "",
    tone: "text-success",
  },
];
const allClear = todos.every((x) => x.n === 0);
---

<AdminLayout title={t("admin.dashboard.title")} active="dashboard">
  <section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="数据概览">
    {
      cards.map((c) =>
        c.href ? (
          <a
            href={c.href}
            class="block rounded-card border border-text-muted/20 bg-bg-card px-4 py-3 transition-shadow hover:shadow-soft"
          >
            <div class="text-xs tracking-wide text-text-muted">{c.label}</div>
            <div class={`mt-1 font-serif text-2xl tabular-nums ${c.tone}`}>
              {c.value}
            </div>
          </a>
        ) : (
          <div class="rounded-card border border-text-muted/20 bg-bg-card px-4 py-3">
            <div class="text-xs tracking-wide text-text-muted">{c.label}</div>
            <div class={`mt-1 font-serif text-2xl tabular-nums ${c.tone}`}>
              {c.value}
            </div>
          </div>
        ),
      )
    }
  </section>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <section class="rounded-card border border-text-muted/20 bg-bg-card p-4">
      <h2 class="mb-2 font-serif text-lg">待办</h2>
      {
        allClear ? (
          <p class="py-4 text-sm text-text-muted">目前没有待办事项。</p>
        ) : (
          <ul class="divide-y divide-text-muted/10">
            {todos.map((x) => (
              <li>
                <a
                  href={x.href}
                  class="flex items-center justify-between gap-3 py-2.5 text-sm hover:text-accent-700"
                >
                  <span>{x.label}</span>
                  <span
                    class={`min-w-[1.75rem] rounded-full px-2 py-0.5 text-center text-xs tabular-nums ${
                      x.n > 0
                        ? "bg-accent-500/15 text-accent-700 font-medium"
                        : "bg-text-muted/10 text-text-muted"
                    }`}
                  >
                    {x.n}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section
      class="rounded-card border border-text-muted/20 bg-bg-card p-4 lg:col-span-2"
    >
      <div class="mb-2 flex items-center justify-between">
        <h2 class="font-serif text-lg">最近订单</h2>
        <a href="/admin/orders" class="text-sm text-accent-700 hover:underline"
          >查看全部 →</a
        >
      </div>
      {
        recent.length === 0 ? (
          <p class="py-4 text-sm text-text-muted">
            {t("admin.orders_list.empty")}
          </p>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <tbody>
                {recent.map((o) => (
                  <tr class="border-t border-text-muted/10 first:border-0">
                    <td class="py-2 pr-3 font-mono text-xs">
                      <a
                        href={`/admin/orders/${o.id}`}
                        class="text-accent-700 hover:underline"
                      >
                        {o.id.slice(-8)}
                      </a>
                    </td>
                    <td class="py-2 pr-3">{o.customer_name}</td>
                    <td class="py-2 pr-3 text-right font-mono">
                      {formatPrice(o.total, o.currency, locale)}
                    </td>
                    <td class="py-2 pr-3">
                      <span
                        class={`rounded px-2 py-0.5 text-xs ${statusColor(o.status)}`}
                      >
                        {tEnum(t, "status", o.status)}
                      </span>
                    </td>
                    <td class="py-2 text-right font-mono text-xs text-text-muted">
                      {new Date(o.created_at * 1000)
                        .toISOString()
                        .slice(5, 16)
                        .replace("T", " ")}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>
  </div>
</AdminLayout>
