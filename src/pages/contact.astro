---
import { XIAOHONGSHU_HANDLE, XIAOHONGSHU_URL } from "../lib/social";
import Layout from "@layouts/Layout.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import AccordionInit from "@components/AccordionInit.astro";
import BreadcrumbSchema from "@components/BreadcrumbSchema.astro";
import FaqSchema from "@components/FaqSchema.astro";
import { createT } from "../i18n/t";
import { defaultLocale, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;

const breadcrumbItems = [
  { name: t("nav.home"), url: "/" },
  { name: t("nav.contact"), url: "/contact" },
];

const faqs = [
  { q: t("contact.faq_q1_q"), a: t("contact.faq_a1_a") },
  { q: t("contact.faq_q2_q"), a: t("contact.faq_a2_a") },
  { q: t("contact.faq_q3_q"), a: t("contact.faq_a3_a") },
  { q: t("contact.faq_q4_q"), a: t("contact.faq_a4_a") },
];
---

<Layout
  title={`${t("contact.title")} — ${t("common.site_name")}`}
  description={t("contact.reply_promise")}
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbItems} />
    <FaqSchema items={faqs} />
  </Fragment>
  <div class="max-w-3xl mx-auto px-6 py-section">
    <RevealOnScroll>
      <header class="mb-12 text-center">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-4"
        >
          {t("contact.kicker")}
        </p>
        <h1
          class="text-display-sm md:text-display-md font-serif text-text-primary mb-3 leading-[1.08]"
        >
          {t("contact.title")}
        </h1>
        <p class="text-text-secondary italic max-w-xl mx-auto">
          {t("contact.subtitle")}
        </p>
      </header>
    </RevealOnScroll>

    <RevealOnScroll>
      <form
        method="POST"
        action="/api/contact"
        class="space-y-5 bg-bg-card border border-forest-100 rounded-card p-6 md:p-8 shadow-soft"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="form-field">
            <input
              id="contact-name"
              type="text"
              required
              maxlength="100"
              name="name"
              placeholder=" "
              class="form-input"
              autocomplete="name"
            />
            <label for="contact-name" class="form-label"
              >{t("contact.name")}</label
            >
          </div>
          <div class="form-field">
            <input
              id="contact-email"
              type="email"
              required
              name="email"
              placeholder=" "
              class="form-input"
              autocomplete="email"
            />
            <label for="contact-email" class="form-label"
              >{t("contact.email")}</label
            >
          </div>
        </div>
        <div class="form-field">
          <input
            id="contact-phone"
            type="tel"
            name="phone"
            placeholder=" "
            class="form-input"
            autocomplete="tel"
          />
          <label for="contact-phone" class="form-label"
            >{t("contact.phone")}</label
          >
        </div>
        <div class="form-field">
          <input
            id="contact-subject"
            type="text"
            name="subject"
            placeholder=" "
            class="form-input"
          />
          <label for="contact-subject" class="form-label"
            >{t("contact.subject")}</label
          >
        </div>
        <div class="form-field">
          <textarea
            id="contact-message"
            required
            name="message"
            rows="6"
            placeholder=" "
            class="form-input form-textarea"></textarea>
          <label for="contact-message" class="form-label"
            >{t("contact.message")}</label
          >
        </div>
        <button
          type="submit"
          class="w-full px-6 py-3 bg-forest-700 text-bg-base rounded-md font-medium hover:bg-forest-900 hover:shadow-soft-lg transition-all duration-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40"
        >
          {t("contact.submit")}
        </button>
      </form>
    </RevealOnScroll>

    <RevealOnScroll>
      <section class="mt-16 pt-10 border-t border-forest-100">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-6 text-center"
        >
          {t("contact.channels_kicker")}
        </p>
        <div
          data-contact-channels
          class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1 text-sm font-sans"
        >
          <div
            class="flex items-baseline gap-3 py-3 border-b border-forest-100/60"
          >
            <span
              class="text-[10px] uppercase tracking-[0.3em] text-terra-500 font-sans w-20 shrink-0"
              >{t("contact.channel_email")}</span
            >
            <a
              href="mailto:oxsupport@0061qwen.cc.cd"
              class="text-forest-700 hover:text-forest-800 underline-offset-2 hover:underline"
              >oxsupport@0061qwen.cc.cd</a
            >
          </div>
          <div
            class="flex items-baseline gap-3 py-3 border-b border-forest-100/60"
          >
            <span
              class="text-[10px] uppercase tracking-[0.3em] text-terra-500 font-sans w-20 shrink-0"
              >{t("contact.channel_xiaohongshu")}</span
            >
            <a
              href={XIAOHONGSHU_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-forest-700 hover:text-forest-800 underline-offset-2 hover:underline"
              >{XIAOHONGSHU_HANDLE}</a
            >
          </div>
          <div
            class="flex items-baseline gap-3 py-3 border-b border-forest-100/60"
          >
            <span
              class="text-[10px] uppercase tracking-[0.3em] text-terra-500 font-sans w-20 shrink-0"
              >{t("contact.channel_wechat")}</span
            >
            <span class="text-forest-700">cnamber_studio</span>
          </div>
          <div
            class="flex items-baseline gap-3 py-3 border-b border-forest-100/60"
          >
            <span
              class="text-[10px] uppercase tracking-[0.3em] text-terra-500 font-sans w-20 shrink-0"
              >{t("contact.channel_studio")}</span
            >
            <span class="text-forest-700">{t("contact.studio_location")}</span>
          </div>
        </div>
      </section>
    </RevealOnScroll>

    <RevealOnScroll>
      <section data-faq-section class="mt-16 pt-10 border-t border-forest-100">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-4"
        >
          {t("contact.faq_kicker")}
        </p>
        <h2
          class="text-display-sm md:text-display-md font-serif text-text-primary mb-12 leading-[1.08]"
        >
          {t("contact.faq_heading")}
        </h2>
        <div data-faq-list class="space-y-8">
          {
            faqs.map((f, i) => (
              <details data-acc open class="border-l-2 border-terra-500 pl-6">
                <summary>
                  <h3 class="text-xl font-serif text-forest-700 mb-2 italic">
                    Q{i + 1}. {f.q}
                  </h3>
                </summary>
                <p class="text-text-secondary leading-relaxed font-sans text-base">
                  {f.a}
                </p>
              </details>
            ))
          }
        </div>
      </section>
    </RevealOnScroll>
  </div>
  <AccordionInit />
</Layout>
