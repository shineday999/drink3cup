---
import Layout from "@layouts/Layout.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import BreadcrumbSchema from "@components/BreadcrumbSchema.astro";
import FaqSchema from "@components/FaqSchema.astro";
import { createT } from "../i18n/t";

const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const groups = [1, 2, 3, 4, 5].map((g) => ({
  id: `g${g}`,
  title: t(`faq.g${g}.title`),
  items: [1, 2, 3, 4, 5].map((n) => ({
    q: t(`faq.g${g}.q${n}`),
    a: t(`faq.g${g}.a${n}`),
  })),
}));
const all = groups.flatMap((g) => g.items);
const breadcrumbItems = [
  { name: t("nav.home"), url: "/" },
  { name: t("faq.breadcrumb"), url: "/faq" },
];
---

<Layout
  title={`${t("faq.title")} — ${t("common.site_name")}`}
  description={t("faq.intro")}
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbItems} />
    <FaqSchema items={all} />
  </Fragment>
  <article class="max-w-3xl mx-auto px-6 py-section">
    <RevealOnScroll>
      <header class="mb-12 text-center">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-4"
        >
          {t("faq.kicker")}
        </p>
        <h1
          class="text-display-sm md:text-display-md font-serif text-text-primary mb-4 leading-[1.08]"
        >
          {t("faq.title")}
        </h1>
        <p class="text-lg text-text-secondary max-w-xl mx-auto">
          {t("faq.intro")}
        </p>
      </header>
    </RevealOnScroll>
    {
      groups.map((g) => (
        <section class="mb-12" id={g.id}>
          <h2 class="font-serif text-2xl text-text-primary mb-4">{g.title}</h2>
          <div class="divide-y divide-forest-700/20 border-y border-forest-700/20">
            {g.items.map((it) => (
              <details class="py-4 group">
                <summary class="cursor-pointer font-sans font-medium text-text-primary">
                  <h3 class="inline">{it.q}</h3>
                </summary>
                <p class="mt-3 text-text-secondary leading-relaxed">{it.a}</p>
              </details>
            ))}
          </div>
        </section>
      ))
    }
  </article>
</Layout>
