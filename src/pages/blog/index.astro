---
import Layout from "@layouts/Layout.astro";
import { env } from "cloudflare:workers";
import { createT } from "../../i18n/t";
import { defaultLocale, localizedPath, type Locale } from "../../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
void locale;

interface BlogPost {
  id: string;
  slug: string;
  category: string | null;
  cover_image_url: string | null;
  published_at: number | null;
  title: string | null;
  excerpt: string | null;
}

const posts = env?.DB
  ? await env.DB.prepare(
      `SELECT p.id, p.slug, p.category, p.cover_image_url, p.published_at,
                pt.locale, pt.title, pt.excerpt
         FROM posts p
         LEFT JOIN post_translations pt ON pt.post_id = p.id AND pt.locale = ?
         WHERE p.status = 'published'
         ORDER BY p.published_at DESC LIMIT 30`,
    )
      .bind(locale)
      .all<BlogPost>()
  : { results: [] as BlogPost[] };
---

<Layout title={`Blog — ${t("common.site_name")}`} description={t("blog.intro")}>
  <div class="max-w-4xl mx-auto px-6 py-section">
    <header class="mb-12 text-center">
      <p
        class="text-sm uppercase tracking-[0.3em] text-accent-700 font-sans mb-3"
      >
        Journal
      </p>
      <h1
        class="text-display-sm md:text-display-md font-serif text-text-primary mb-3"
      >
        {t("blog.title")}
      </h1>
      <p class="text-text-secondary max-w-2xl mx-auto">{t("blog.intro")}</p>
    </header>

    {
      posts.results.length === 0 ? (
        <p class="text-center text-text-muted py-12">{t("blog.empty")}</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {posts.results.map((p) => (
            <a
              href={localizedPath(locale, `/blog/${p.slug}`)}
              class="block bg-bg-card border border-text-muted/20 rounded-card overflow-hidden hover:border-accent-500 transition-colors"
            >
              <div class="aspect-video bg-forest-100 flex items-center justify-center">
                {p.cover_image_url ? (
                  <img
                    decoding="async"
                    src={p.cover_image_url}
                    alt={p.title ?? ""}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <svg
                    class="w-16 h-16 text-forest-300"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <circle cx="12" cy="12" r="6" opacity="0.3" />
                    <circle cx="12" cy="12" r="3" opacity="0.6" />
                  </svg>
                )}
              </div>
              <div class="p-5">
                {p.category && (
                  <div class="text-xs uppercase tracking-wider text-accent-700 mb-2">
                    {p.category}
                  </div>
                )}
                <h2 class="font-serif text-xl mb-2 text-text-primary">
                  {p.title ?? p.slug}
                </h2>
                {p.excerpt && (
                  <p class="text-sm text-text-secondary line-clamp-3">
                    {p.excerpt}
                  </p>
                )}
                {p.published_at && (
                  <div class="text-xs text-text-muted mt-3">
                    {new Date(p.published_at * 1000).toISOString().slice(0, 10)}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Layout>
