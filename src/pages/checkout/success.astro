---
import Layout from "@layouts/Layout.astro";
import { createT } from "../../i18n/t";
import { defaultLocale, localizedPath, type Locale } from "../../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const homePath = localizedPath(locale, "/");
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);
const orderId = Astro.url.searchParams.get("id") ?? "";
---

<Layout
  title={`${t("checkout.success_title") ?? "Order received"} — ${t("common.site_name")}`}
  description={`We've received your order. Our studio will write back within 1–2 business days. — ${t("common.site_name")}`}
>
  <div data-co-success class="max-w-2xl mx-auto px-6 py-section text-center">
    <div class="text-accent-700 mb-6">
      <svg
        class="w-20 h-20 mx-auto"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h1 class="text-display-sm font-serif text-text-primary mb-4">
      {t("checkout.success_title") ?? "Thank you for your reservation"}
    </h1>
    <p class="text-lg text-text-secondary mb-2">
      {t("checkout.success_intro") ?? "We have received your reservation."}
    </p>
    <p class="text-text-secondary mb-6">
      {
        t("checkout.success_next") ??
          "We will contact you within 1–2 business days via email."
      }
    </p>
    {
      orderId && (
        <p class="text-xs text-text-muted font-mono">
          {t("checkout.success_order_id")}: {orderId}
        </p>
      )
    }
    <a href={homePath} class="text-accent-700 underline mt-8 inline-block">
      ← {t("common.back")}
    </a>
    <div class="cs-bar" data-cs-bar>
      <a class="cs-home" href={homePath}>{t("nav.home")}</a>
      <a class="cs-more" href={localizedPath(locale, "/products")}
        >{t("common.view_more")} →</a
      >
    </div>
  </div>
</Layout>
