---
import { formatPrice } from "@lib/format";
import Layout from "@layouts/Layout.astro";
import { env } from "cloudflare:workers";
import ProductCard from "@components/ProductCard.astro";
import { createT } from "../../i18n/t";
import { defaultLocale, localizedPath, type Locale } from "../../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const type = Astro.url.searchParams.get("type") ?? "jewelry";
const idsParam = Astro.url.searchParams.get("ids") ?? "";
const scoresParam = Astro.url.searchParams.get("scores") ?? "";

const scoreMap: Record<string, number> = {};
if (scoresParam) {
  for (const pair of scoresParam.split(",")) {
    const [id, score] = pair.split(":");
    if (id && score !== undefined) scoreMap[id] = parseInt(score, 10) || 0;
  }
}

interface QuizResult {
  id: string;
  slug: string;
  category: string;
  name: string | null;
  short_description: string | null;
  min_price: number | null;
  min_currency: string | null;
  image_urls: string | null;
}

const products =
  idsParam && env?.DB
    ? await env.DB.prepare(
        `SELECT p.id, p.slug, p.category, pt.name, pt.short_description,
                MIN(pp.amount) AS min_price, pp.currency AS min_currency,
                (SELECT pv.image_urls FROM product_variants pv WHERE pv.product_id = p.id LIMIT 1) AS image_urls
         FROM products p
         LEFT JOIN product_translations pt ON pt.product_id = p.id AND pt.locale = ?
         LEFT JOIN product_variants pv ON pv.product_id = p.id
         LEFT JOIN product_prices pp ON pp.variant_id = pv.id AND pp.currency = 'CNY'
         WHERE p.id IN (${idsParam
           .split(",")
           .map(() => "?")
           .join(",")}) AND p.status = 'active'
         GROUP BY p.id`,
      )
        .bind(locale, ...idsParam.split(","))
        .all<QuizResult>()
    : { results: [] as QuizResult[] };

function firstImage(json: string | null | undefined): string | undefined {
  if (!json) return undefined;
  try {
    const urls = JSON.parse(json) as string[];
    return Array.isArray(urls) && urls.length > 0 ? urls[0] : undefined;
  } catch {
    return undefined;
  }
}

const pageTitle = `${t("quiz.result.title")} — ${t("common.site_name")}`;
void locale;
---

<Layout title={pageTitle} description={t("quiz.result.intro")}>
  <div data-quiz-result-page class="max-w-5xl mx-auto px-6 py-section">
    <header class="text-center mb-12">
      <p
        class="text-sm uppercase tracking-[0.3em] text-accent-700 font-sans mb-3"
      >
        {
          type === "jewelry"
            ? t("quiz.jewelry.title")
            : type === "tea"
              ? t("quiz.tea.title")
              : t("quiz.incense.title")
        }
      </p>
      <h1
        class="text-display-sm md:text-display-md font-serif text-text-primary mb-3"
      >
        {t("quiz.result.title")}
      </h1>
      <p class="text-text-secondary max-w-2xl mx-auto">
        {t("quiz.result.intro")}
      </p>
    </header>

    {
      products.results.length === 0 ? (
        <div class="text-center py-section text-text-muted">
          <p class="text-lg mb-2">{t("quiz.result.empty")}</p>
          <p class="text-sm">{t("quiz.result.empty_hint")}</p>
          <a
            href={localizedPath(locale, "/products")}
            class="text-accent-700 underline mt-4 inline-block"
          >
            {t("common.view_more")} →
          </a>
        </div>
      ) : (
        <div
          data-quiz-results
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12"
        >
          {products.results.map((p) => {
            const sc = scoreMap[p.id];
            const isFallback = sc === 0;
            const isStrong = sc !== undefined && sc >= 2;
            const badgeClass = isStrong
              ? "bg-accent-700 text-bg-base"
              : sc === 1
                ? "bg-forest-700 text-bg-base"
                : "bg-text-muted/80 text-bg-base";
            const badgeLabel = isStrong
              ? t("quiz.result.badge_strong_match")
              : sc === 1
                ? t("quiz.result.badge_match")
                : t("quiz.result.badge_fallback");
            return (
              <div>
                {sc !== undefined && (
                  <div class="mb-2 flex">
                    <span
                      class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium ${badgeClass}`}
                    >
                      {isStrong ? "★ " : isFallback ? "· " : ""}
                      {badgeLabel}
                    </span>
                  </div>
                )}
                <ProductCard
                  slug={p.slug}
                  name={p.name ?? p.slug}
                  shortDescription={p.short_description ?? undefined}
                  category={p.category}
                  imageUrl={firstImage(p.image_urls)}
                  priceFrom={
                    p.min_price
                      ? formatPrice(
                          p.min_price,
                          p.min_currency ?? "CNY",
                          locale,
                        )
                      : undefined
                  }
                />
              </div>
            );
          })}
        </div>
      )
    }

    <div data-quiz-old-retake class="text-center">
      <a
        href={localizedPath(locale, "/quiz")}
        class="text-text-secondary hover:text-text-primary text-sm"
      >
        ← {t("quiz.retake")}
      </a>
    </div>
    <div class="qr-bar" data-quiz-bar>
      <a class="qr-retake" href={localizedPath(locale, "/quiz")}
        >{t("quiz.retake")}</a
      >
      <a class="qr-more" href={localizedPath(locale, "/products")}
        >{t("common.view_more")} →</a
      >
    </div>
  </div>
</Layout>
