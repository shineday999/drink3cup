---
import Layout from "@layouts/Layout.astro";
import RevealOnScroll from "@components/RevealOnScroll.astro";
import AccordionInit from "@components/AccordionInit.astro";
import ContinueReading from "@components/ContinueReading.astro";
import BreadcrumbSchema from "@components/BreadcrumbSchema.astro";
import FaqSchema from "@components/FaqSchema.astro";
import { createT } from "../i18n/t";
import { defaultLocale, localizedPath, type Locale } from "../i18n/config";

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const messages = (Astro.locals.messages ?? {}) as Record<string, unknown>;
const t = createT(messages);

const breadcrumbItems = [
  { name: t("nav.home"), url: "/" },
  { name: t("nav.about"), url: "/about" },
];

const faqs = [
  { q: t("about.faq_q1_q"), a: t("about.faq_a1_a") },
  { q: t("about.faq_q2_q"), a: t("about.faq_a2_a") },
  { q: t("about.faq_q3_q"), a: t("about.faq_a3_a") },
  { q: t("about.faq_q4_q"), a: t("about.faq_a4_a") },
];
---

<Layout
  title={`${t("about.title")} — ${t("common.site_name")}`}
  description={t("about.p1")}
>
  <Fragment slot="head">
    <BreadcrumbSchema items={breadcrumbItems} />
    <FaqSchema items={faqs} />
  </Fragment>
  <article class="max-w-3xl mx-auto px-6 py-section">
    <RevealOnScroll>
      <header class="mb-16 text-center">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-4"
        >
          {t("about.kicker")}
        </p>
        <h1
          class="text-display-sm md:text-display-md font-serif text-text-primary mb-4 leading-[1.08]"
        >
          {t("about.title")}
        </h1>
        <p class="text-lg text-text-secondary italic max-w-xl mx-auto">
          {t("about.subtitle")}
        </p>
      </header>
    </RevealOnScroll>

    <RevealOnScroll>
      <div
        class="prose prose-lg max-w-none space-y-6 text-text-secondary font-sans leading-relaxed text-base"
      >
        <p>{t("about.p1")}</p>
        <p>{t("about.p2")}</p>
        <blockquote class="my-10 pl-6 border-l-2 border-terra-500">
          <p
            class="text-xl md:text-2xl font-serif italic text-forest-700 leading-snug"
          >
            {t("about.p3")}
          </p>
        </blockquote>
        <p>{t("about.p4")}</p>
      </div>
    </RevealOnScroll>
  </article>
  <div class="max-w-3xl mx-auto px-6 py-section">
    <RevealOnScroll>
      <section data-faq-section class="border-t border-forest-100 pt-16">
        <p
          class="text-[10px] uppercase tracking-[0.4em] text-forest-600 font-sans mb-4"
        >
          {t("about.faq_kicker")}
        </p>
        <h2
          class="text-display-sm md:text-display-md font-serif text-text-primary mb-12 leading-[1.08]"
        >
          {t("about.faq_heading")}
        </h2>
        <div data-faq-list class="space-y-8">
          {
            faqs.map((f, i) => (
              <details data-acc open class="border-l-2 border-terra-500 pl-6">
                <summary>
                  <h3 class="text-xl font-serif text-forest-700 mb-2 italic">
                    Q{i + 1}. {f.q}
                  </h3>
                </summary>
                <p class="text-text-secondary leading-relaxed font-sans text-base">
                  {f.a}
                </p>
              </details>
            ))
          }
        </div>
      </section>
    </RevealOnScroll>
  </div>
  <div class="max-w-5xl mx-auto px-6 pb-section">
    <ContinueReading
      heading={t("continue.heading")}
      links={[
        {
          href: localizedPath(locale, "/story"),
          label: t("about.story_label"),
          desc: t("about.story_desc"),
        },
        {
          href: localizedPath(locale, "/roasting"),
          label: t("about.craft_label"),
          desc: t("about.craft_desc"),
        },
      ]}
    />
  </div>
  <AccordionInit />
</Layout>
