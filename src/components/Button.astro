---
// Button — 設計系統共用按鈕
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "accent";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  class?: string;
  disabled?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  disabled = false,
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center font-sans font-medium rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed";

const variants = {
  primary: "bg-forest-700 text-bg-base hover:bg-forest-900",
  secondary:
    "bg-bg-card border border-text-muted/30 text-text-primary hover:bg-bg-base",
  ghost: "text-text-primary hover:bg-bg-base",
  accent: "bg-accent-700 text-bg-base hover:bg-accent-500",
};

const sizes = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-4 py-2 text-base",
  lg: "px-6 py-3 text-lg",
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
