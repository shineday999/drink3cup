---
// Tabs — client-side toggle (no SSR round-trip per click).
// Wave 20: rewrite to <button> + JS so it works without ClientRouter /
// without URL param round-trip. Each panel uses data-tab-panel matching
// the corresponding data-tab-trigger id. `defaultTab` decides initial.
interface Tab {
  id: string;
  label: string;
}
interface Props {
  tabs: Tab[];
  defaultTab?: string;
}

const { tabs, defaultTab } = Astro.props;
const active = defaultTab ?? tabs[0]?.id ?? "";
---

<div data-tabs>
  <nav class="flex gap-1 border-b border-text-muted/20 mb-6">
    {
      tabs.map((tab) => (
        <button
          type="button"
          data-tab-trigger={tab.id}
          class:list={[
            "px-4 py-2 text-sm font-medium border-b-2 transition-colors",
            tab.id === active
              ? "border-accent-700 text-accent-700"
              : "border-transparent text-text-muted hover:text-text-primary",
          ]}
        >
          {tab.label}
        </button>
      ))
    }
  </nav>

  <div data-tab-panels>
    <div data-tab-panel={tabs[0]?.id} hidden={tabs[0]?.id !== active}>
      <slot name="core" />
    </div>
    <div data-tab-panel={tabs[1]?.id} hidden={tabs[1]?.id !== active}>
      <slot name="translations" />
    </div>
    <div data-tab-panel={tabs[2]?.id} hidden={tabs[2]?.id !== active}>
      <slot name="variants" />
    </div>
    <div data-tab-panel="meta" hidden={true}><slot name="meta" /></div>
    <div data-tab-panel="faq" hidden={true}><slot name="faq" /></div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-tabs]").forEach(function (container) {
      var triggers = container.querySelectorAll("[data-tab-trigger]");
      var panels = container.querySelectorAll("[data-tab-panel]");
      triggers.forEach(function (trigger) {
        trigger.addEventListener("click", function () {
          var target = trigger.getAttribute("data-tab-trigger");
          if (!target) return;
          triggers.forEach(function (t) {
            var isActive = t.getAttribute("data-tab-trigger") === target;
            t.classList.remove("border-accent-700", "text-accent-700");
            t.classList.add("border-transparent", "text-text-muted");
            if (isActive) {
              t.classList.add("border-accent-700", "text-accent-700");
              t.classList.remove("border-transparent", "text-text-muted");
            }
          });
          panels.forEach(function (panel) {
            var isActive = panel.getAttribute("data-tab-panel") === target;
            if (isActive) {
              panel.removeAttribute("hidden");
            } else {
              panel.setAttribute("hidden", "");
            }
          });
        });
      });
    });
  })();
</script>
