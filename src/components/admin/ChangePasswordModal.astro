---
// ChangePasswordModal — 改密碼彈窗
// 由 AdminLayout 引入。SSR 渲染 markup,client JS 控制開關。
// 表單走原生 POST + 303 redirect,沿用 settings.astro?saved=1 / login.astro?error=xxx 慣例。
import { createT } from "../../i18n/t";
import zhHansMessages from "../../i18n/messages/zh-Hant.json";

interface Props {
  currentPath: string;
  error?: string | null;
  saved?: boolean;
}

const { currentPath, error = null, saved = false } = Astro.props;
const messages = zhHansMessages as Record<string, unknown>;
const t = createT(messages);

// SSR 階段就決定 modal 開不開(給 ?pw_error=xxx 場景)
const shouldOpen = error !== null;
---

<dialog
  id="change-password-modal"
  data-change-password-modal
  aria-labelledby="change-password-title"
  aria-describedby="change-password-desc"
  class="rounded-card p-0 bg-transparent backdrop:bg-forest-900/50 max-w-md w-[92vw]"
  open={shouldOpen ? true : undefined}
>
  <div
    class="bg-bg-card border border-text-muted/20 rounded-card shadow-soft p-6"
  >
    <header class="flex items-start justify-between mb-4">
      <div>
        <h2
          id="change-password-title"
          class="text-lg font-serif text-text-primary"
        >
          {t("admin.change_password.title")}
        </h2>
        <p id="change-password-desc" class="text-xs text-text-muted mt-1">
          {t("admin.change_password.hint_min_length")}
        </p>
      </div>
      <button
        type="button"
        class="text-text-muted hover:text-text-primary p-1 -m-1"
        data-change-password-close
        aria-label={t("admin.change_password.cancel")}
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </header>

    {
      saved && (
        <div class="mb-4 p-3 border border-success/30 bg-success/10 text-success text-sm rounded">
          {t("admin.change_password.saved")}
        </div>
      )
    }

    {
      error && (
        <div class="mb-4 p-3 border border-error/30 bg-error/10 text-error text-sm rounded">
          {error === "empty" && t("admin.change_password.error_empty")}
          {error === "mismatch" && t("admin.change_password.error_mismatch")}
          {error === "too_short" && t("admin.change_password.error_too_short")}
          {error === "wrong_current" &&
            t("admin.change_password.error_wrong_current")}
          {error === "same_as_current" &&
            t("admin.change_password.error_same_as_current")}
          {error === "rate_limited" &&
            t("admin.change_password.error_rate_limited")}
        </div>
      )
    }

    <form method="POST" action="/api/admin/change-password" class="space-y-4">
      <input type="hidden" name="redirect" value={currentPath} />
      <div>
        <label class="block text-sm font-medium mb-1" for="cp-current">
          {t("admin.change_password.current_password_label")}
        </label>
        <input
          id="cp-current"
          name="current_password"
          type="password"
          required
          autocomplete="current-password"
          autofocus
          class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
        />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1" for="cp-new">
          {t("admin.change_password.new_password_label")}
        </label>
        <input
          id="cp-new"
          name="new_password"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
        />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1" for="cp-confirm">
          {t("admin.change_password.confirm_password_label")}
        </label>
        <input
          id="cp-confirm"
          name="confirm_password"
          type="password"
          required
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          class="w-full px-3 py-2 border border-text-muted/30 rounded-md bg-bg-base"
        />
      </div>
      <div class="flex items-center gap-3 pt-2">
        <button
          type="submit"
          class="px-4 py-2 bg-forest-700 text-bg-base rounded-md font-medium hover:bg-forest-900 transition-colors"
        >
          {t("admin.change_password.submit")}
        </button>
        <button
          type="button"
          class="text-text-muted hover:text-text-primary text-sm underline"
          data-change-password-close
        >
          {t("admin.change_password.cancel")}
        </button>
      </div>
    </form>
  </div>
</dialog>

<style is:global>
  dialog#change-password-modal::backdrop {
    background: rgba(28, 19, 13, 0.55);
    backdrop-filter: blur(2px);
  }
</style>

<script>
  (function () {
    const modal = document.getElementById(
      "change-password-modal",
    ) as HTMLDialogElement | null;
    if (!modal) return;
    const triggers = document.querySelectorAll<HTMLButtonElement>(
      "[data-change-password-trigger]",
    );
    const closes = document.querySelectorAll<HTMLElement>(
      "[data-change-password-close]",
    );

    triggers.forEach((b) =>
      b.addEventListener("click", () => {
        modal.showModal();
        const first = modal.querySelector<HTMLInputElement>(
          "input[type=password]",
        );
        first?.focus();
      }),
    );
    closes.forEach((b) => b.addEventListener("click", () => modal.close()));

    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    if (modal.hasAttribute("open") && !modal.matches(":modal")) {
      modal.showModal();
    }
  })();
</script>
