---
// Card — 共用卡片容器
interface Props {
  class?: string;
  href?: string;
  padded?: boolean;
}

const { class: className = "", href, padded = true } = Astro.props;
const base = `bg-bg-card border border-text-muted/20 rounded-card ${padded ? "p-5" : ""} ${className}`;
---

{
  href ? (
    <a
      href={href}
      class={`${base} block hover:border-accent-500 transition-colors`}
    >
      <slot />
    </a>
  ) : (
    <div class={base}>
      <slot />
    </div>
  )
}
