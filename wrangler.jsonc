{
  // NEW site: https://mycafe.de5.net  (completely separate from any other project)
  // IDs below are PLACEHOLDERS. Create NEW resources in Cloudflare and paste the IDs here.
  // See docs/PLAN.md step S11.
  "name": "mycafe",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mycafe",
      "database_id": "bbc01b28-0f51-458b-9a1a-36b73fd8fef7",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "mycafe-images",
    },
  ],
  "kv_namespaces": [
    { "binding": "I18N", "id": "97403ca1a3b245089e8364ffc98197eb" },
    { "binding": "SESSION", "id": "0e89a95b442b4f6482e49348512aacc4" },
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "SITE_URL": "https://mycafe.de5.net",
    "EMAIL_FROM": "喝三杯咖啡 <weider@0061qwen.cc.cd>",
    // 網站分析(皆不是機密)。必須是「本站自己的」帳戶,不可使用其他網站的 ID。
    // 目前:直接使用 GA4,不經過 GTM,立即開始收資料。
    // 若要改走 GTM:把下面 GTM_CONTAINER_ID 填成 "GTM-WMBGGQ8J"(GTM 優先),並在 GTM 後台設定標記,
    // 見 docs/PLAN.md「S36 擁有者設定」。兩者同時設定時只會載入 GTM,不會重複計算。
    "GTM_CONTAINER_ID": "",
    "GA_MEASUREMENT_ID": "G-6CFV7K8C9W",
    "EMAIL_REPLY_TO": "weider@0061qwen.cc.cd",
  },
}
